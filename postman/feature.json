    {
      "name": "Получение событий подписок",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const main = async () => {\r",
              "    const api = new API(pm);\r",
              "    const rnd = new RandomUtils();\r",
              "\r",
              "    try {\r",
              "        // пользователь — автор события\r",
              "        const initiator = await api.addUser(rnd.getUser());\r",
              "\r",
              "        // пользователь — подписчик\r",
              "        const follower = await api.addUser(rnd.getUser());\r",
              "\r",
              "        // категория\r",
              "        const category = await api.addCategory(rnd.getCategory());\r",
              "\r",
              "        // событие\r",
              "        let event = await api.addEvent(initiator.id, rnd.getEvent(category.id));\r",
              "        event = await api.publishEvent(event.id);\r",
              "\r",
              "        // подписка\r",
              "        await api.subscribeToUser(follower.id, initiator.id);\r",
              "\r",
              "        // path variable\r",
              "        pm.collectionVariables.set('userId', follower.id);\r",
              "\r",
              "        // query variables\r",
              "        pm.collectionVariables.set('text', event.annotation);\r",
              "        pm.collectionVariables.set('categoryId', category.id);\r",
              "        pm.collectionVariables.set('paid', event.paid);\r",
              "\r",
              "        // ожидаемый результат\r",
              "        pm.collectionVariables.set('response', event);\r",
              "\r",
              "    } catch (e) {\r",
              "        console.error('Ошибка подготовки данных', e);\r",
              "    }\r",
              "};\r",
              "\r",
              "const interval = setInterval(() => {}, 1000);\r",
              "\r",
              "setTimeout(async () => {\r",
              "    try {\r",
              "        await main();\r",
              "    } finally {\r",
              "        clearInterval(interval);\r",
              "    }\r",
              "}, 100);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус 200 и JSON\", function () {\r",
              "    pm.response.to.be.ok;\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "const source = pm.collectionVariables.get('response');\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.test(\"Ответ не пустой\", function () {\r",
              "    pm.expect(body.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "const target = body[0];\r",
              "\r",
              "pm.test(\"Поля события присутствуют\", function () {\r",
              "    pm.expect(target).to.have.property('id');\r",
              "    pm.expect(target).to.have.property('title');\r",
              "    pm.expect(target).to.have.property('annotation');\r",
              "    pm.expect(target).to.have.property('category');\r",
              "    pm.expect(target).to.have.property('paid');\r",
              "    pm.expect(target).to.have.property('eventDate');\r",
              "    pm.expect(target).to.have.property('initiator');\r",
              "    pm.expect(target).to.have.property('views');\r",
              "    pm.expect(target).to.have.property('confirmedRequests');\r",
              "});\r",
              "\r",
              "pm.test(\"Событие принадлежит пользователю, на которого есть подписка\", function () {\r",
              "    pm.expect(target.initiator.id)\r",
              "        .to.equal(source.initiator.id);\r",
              "});\r",
              "\r",
              "pm.test(\"Данные события совпадают с ожидаемыми\", function () {\r",
              "    pm.expect(target.title).to.equal(source.title);\r",
              "    pm.expect(target.annotation).to.equal(source.annotation);\r",
              "    pm.expect(target.category.id).to.equal(source.category.id);\r",
              "    pm.expect(target.paid.toString()).to.equal(source.paid.toString());\r",
              "    pm.expect(target.eventDate).to.equal(source.eventDate);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/users/{{userId}}/subscriptions?text={{text}}&categories={{categoryId}}&paid={{paid}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "{{userId}}",
            "subscriptions"
          ],
          "query": [
            {
              "key": "text",
              "value": "{{text}}"
            },
            {
              "key": "categories",
              "value": "{{categoryId}}"
            },
            {
              "key": "paid",
              "value": "{{paid}}"
            }
          ]
        }
      },
      "response": []
    }
